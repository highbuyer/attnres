def _is_degenerate_output(text: str) -> bool:
    stripped = text.strip()
    if not stripped:
        return False
    if len(stripped) < 64:
        return False
    allowed = {"-", "—", "_", " ", "\n", "\t", ".", "*"}
    if all(ch in allowed for ch in stripped):
        return True
    segments = [seg for seg in stripped.replace("\n", " ").split(" ") if seg]
    if len(segments) >= 20:
        repetitive = sum(1 for seg in segments if seg in {"---", "—", "_", "***", "----"})
        if repetitive / len(segments) >= 0.6:
            return True
    # n-gram 循环检测：1~6 长度的 n-gram 若连续重复 >=3 次即视为退化
    if len(segments) >= 12:
        for n in range(1, 7):
            if len(segments) < n * 3:
                continue
            for start in range(len(segments) - n * 3 + 1):
                gram = tuple(segments[start:start + n])
                repeats = 1
                pos = start + n
                while pos + n <= len(segments) and tuple(segments[pos:pos + n]) == gram:
                    repeats += 1
                    pos += n
                if repeats >= 3:
                    return True
    # 字符级窗口重复（英文/中文混合无空格时）：取 32 字符窗口若整段重复 >=3 次
    if len(stripped) >= 96:
        for window in (16, 24, 32, 48):
            chunk = stripped[:window]
            if chunk and stripped.count(chunk) >= 3:
                return True
    return False


_SYSTEM_REMINDER_RE = re.compile(r"<system-reminder>.*?</system-reminder>", re.DOTALL | re.IGNORECASE)
_LOCAL_CAVEAT_RE = re.compile(r"<local-command-caveat>.*?</local-command-caveat>", re.DOTALL | re.IGNORECASE)
_COMMAND_BLOCK_RE = re.compile(
    r"<(?:local-)?command-(?:name|message|args|stdout|stderr)>.*?</(?:local-)?command-(?:name|message|args|stdout|stderr)>",
    re.DOTALL | re.IGNORECASE,
)
_EMPTY_TAG_RE = re.compile(r"<[a-zA-Z][a-zA-Z0-9\-]*\s*/?>|</[a-zA-Z][a-zA-Z0-9\-]*>")
_META_NOISE_PATTERNS = (_SYSTEM_REMINDER_RE, _LOCAL_CAVEAT_RE, _COMMAND_BLOCK_RE)


# ---------------------------------------------------------------------------
# 400M 模型在 tool_call JSON 参数上幻觉 query/path（见 memory
# feedback_cc_400m_ceiling.md）。推理侧后处理：若模型生成的 query/path
# 不是 user prompt 字面子串，直接从 user prompt 抽最显眼 symbol/path 替代。
# 400M 的 query 幻觉与 user 语义无关，字面相似度匹配无效，必须硬替换。
# ---------------------------------------------------------------------------
_BACKTICK_RE = re.compile(r"`([^`]+)`")
_SYMBOL_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]{2,}")
_PATH_RE = re.compile(r"(?:[A-Za-z_][\w\-]*/)+[\w\-\.]+\.(?:py|md|json|txt|sh|yaml|yml)")
_OPT_RE = re.compile(r"--[a-z][a-z0-9\-]+")


def _pick_query_from_prompt(prompt_text: str) -> str | None:
    """从 user prompt 选最显眼的 identifier 作为 search query。优先级：
    反引号包裹 > --option > UPPER_CASE 常量 > 最长 snake_case identifier。
    """
    if not prompt_text:
        return None
    # 1. 反引号里的第一个 identifier / option / path-like
    for m in _BACKTICK_RE.findall(prompt_text):
        m = m.strip()
        if _OPT_RE.fullmatch(m) or _SYMBOL_RE.fullmatch(m):
            return m
        # 反引号里可能是 path 或复合表达，取第一个 identifier/option
        opt = _OPT_RE.search(m)
        if opt:
            return opt.group(0)
        sym = _SYMBOL_RE.search(m)
        if sym:
            return sym.group(0)
    # 2. --option
    opts = _OPT_RE.findall(prompt_text)
    if opts:
        return opts[0]
    # 3. UPPER_CASE 常量
    uppers = [s for s in _SYMBOL_RE.findall(prompt_text) if s.isupper() and len(s) >= 4]
    if uppers:
        return uppers[0]
    # 4. 最长的 snake_case identifier（有 _ 的优先）
    syms = [s for s in _SYMBOL_RE.findall(prompt_text) if len(s) >= 4]
    snake = [s for s in syms if "_" in s]
    if snake:
        return max(snake, key=len)
    if syms:
        return max(syms, key=len)
    return None


def _pick_path_from_prompt(prompt_text: str) -> str | None:
    paths = _PATH_RE.findall(prompt_text)
    return paths[0] if paths else None


def _sanitize_tool_params(prompt_text: str, tool_name: str, params: dict, debug=None) -> dict:
    """字面校验 params；不字面则直接硬替换为 user prompt 的显眼候选。"""
    if not isinstance(params, dict) or not prompt_text:
        return params
    fixed = dict(params)
    changed: list[str] = []
    for key in ("query", "path"):
        if key not in fixed:
            continue
        val = fixed[key]
        if not isinstance(val, str) or not val.strip():
            continue
        if val in prompt_text:
            continue  # 已字面，不动
        replacement = _pick_path_from_prompt(prompt_text) if key == "path" else _pick_query_from_prompt(prompt_text)
        if replacement and replacement != val:
            fixed[key] = replacement
            changed.append(f"{key}:{val!r}→{replacement!r}")
        elif key == "path":
            # path 幻觉且 user 里也无 path 候选 → 删除让搜索走全仓根
            del fixed[key]
            changed.append(f"{key}:{val!r}→(removed)")
    if changed and debug:
        debug(f"tool_params sanitize tool={tool_name} {' '.join(changed)}")
    return fixed


def _sanitize_long_prompt(prompt_text: str, max_chars: int = 4000) -> str:
    """剥离 system-reminder / local-command-* / command-* 等噪声块，并清理残留空标签。"""
    if not prompt_text:
        return prompt_text
    cleaned = prompt_text
    for pattern in _META_NOISE_PATTERNS:
        cleaned = pattern.sub(" ", cleaned)
    # 清掉任何残留的孤立开/闭标签（例如未配对的 <local-command-stdout> 壳）
    cleaned = _EMPTY_TAG_RE.sub(" ", cleaned)
    cleaned = re.sub(r"\n{3,}", "\n\n", cleaned)
    cleaned = re.sub(r"[ \t]{2,}", " ", cleaned).strip()
    if len(cleaned) > max_chars:
        cleaned = cleaned[-max_chars:]
    return cleaned


def _extract_responses_input(body) -> str:
    data = body.get("input", "")
    if isinstance(data, str):
        return data.strip()

    parts = []

    def add_text(value):
        if isinstance(value, str):
            value = value.strip()
            if value:
                parts.append(value)

    if isinstance(data, list):
        for item in data:
            if isinstance(item, str):
                add_text(item)
                continue
            if not isinstance(item, dict):
                continue

            content = item.get("content", "")
            if isinstance(content, str):
                add_text(content)
                continue
            if not isinstance(content, list):
                continue

            for block in content:
                if not isinstance(block, dict):
                    continue
                if block.get("type") in {"input_text", "text", "output_text"}:
                    add_text(block.get("text", ""))

    return "\n".join(parts).strip()




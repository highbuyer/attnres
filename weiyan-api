SESSION_FILENAME = ".weiyan-session.json"
SESSION_RECENT_MAX = 8


def _session_path(tool_dir: str | None) -> Path | None:
    if not tool_dir:
        return None
    return Path(tool_dir) / SESSION_FILENAME


def _session_load(tool_dir: str | None) -> dict:
    p = _session_path(tool_dir)
    if not p or not p.exists():
        return {"recent_queries": [], "recent_files": [], "recent_shortcuts": []}
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        return {"recent_queries": [], "recent_files": [], "recent_shortcuts": []}


def _session_save(tool_dir: str | None, data: dict) -> None:
    p = _session_path(tool_dir)
    if not p:
        return
    try:
        p.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
    except OSError:
        pass  # 写失败静默，session 是 best-effort


def _session_record(tool_dir: str | None, *, query: str | None = None,
                    file_ref: str | None = None, shortcut: str | None = None) -> None:
    if not tool_dir:
        return
    data = _session_load(tool_dir)
    if query:
        q = query.strip()[:200]
        if q and (not data["recent_queries"] or data["recent_queries"][-1] != q):
            data["recent_queries"].append(q)
            data["recent_queries"] = data["recent_queries"][-SESSION_RECENT_MAX:]
    if file_ref:
        if file_ref in data["recent_files"]:
            data["recent_files"].remove(file_ref)
        data["recent_files"].append(file_ref)
        data["recent_files"] = data["recent_files"][-SESSION_RECENT_MAX:]
    if shortcut:
        data["recent_shortcuts"].append({"t": int(time.time()), "kind": shortcut})
        data["recent_shortcuts"] = data["recent_shortcuts"][-SESSION_RECENT_MAX:]
    _session_save(tool_dir, data)


def _session_resolve_file_ref(prompt_text: str, tool_dir: str | None) -> str | None:
    """若 prompt 是"那 X 呢" / "X 是什么意思"这种省略了文件的跟进问，
    从 session.recent_files 里拿最近用过的文件名当默认引用。
    只在 prompt 里已经有"那/呢/是什么"这些指代词时触发。
    """
    if not tool_dir or not prompt_text:
        return None
    normalized = re.sub(r"\s+", "", prompt_text)
    # 长度 <=6 且含指代词 → 很可能是省略追问
    if len(normalized) > 12:
        return None
    if not any(k in normalized for k in ("那", "它", "这个", "刚才", "上面", "前面", "呢")):
        return None
    data = _session_load(tool_dir)
    if data["recent_files"]:
        return data["recent_files"][-1]
    return None



def _is_degenerate_output(text: str) -> bool:
    stripped = text.strip()
    if not stripped:
        return False
    if len(stripped) < 64:
        return False
    allowed = {"-", "—", "_", " ", "\n", "\t", ".", "*"}
    if all(ch in allowed for ch in stripped):
        return True
    segments = [seg for seg in stripped.replace("\n", " ").split(" ") if seg]
    if len(segments) >= 20:
        repetitive = sum(1 for seg in segments if seg in {"---", "—", "_", "***", "----"})
        if repetitive / len(segments) >= 0.6:
            return True
    # n-gram 循环检测：1~6 长度的 n-gram 若连续重复 >=3 次即视为退化
    if len(segments) >= 12:
        for n in range(1, 7):
            if len(segments) < n * 3:
                continue
            for start in range(len(segments) - n * 3 + 1):
                gram = tuple(segments[start:start + n])
                repeats = 1
                pos = start + n
                while pos + n <= len(segments) and tuple(segments[pos:pos + n]) == gram:
                    repeats += 1
                    pos += n
                if repeats >= 3:
                    return True
    # 字符级窗口重复（英文/中文混合无空格时）：取 32 字符窗口若整段重复 >=3 次
    if len(stripped) >= 96:
        for window in (16, 24, 32, 48):
            chunk = stripped[:window]
            if chunk and stripped.count(chunk) >= 3:
                return True
    return False


_SYSTEM_REMINDER_RE = re.compile(r"<system-reminder>.*?</system-reminder>", re.DOTALL | re.IGNORECASE)
_LOCAL_CAVEAT_RE = re.compile(r"<local-command-caveat>.*?</local-command-caveat>", re.DOTALL | re.IGNORECASE)
_COMMAND_BLOCK_RE = re.compile(
    r"<(?:local-)?command-(?:name|message|args|stdout|stderr)>.*?</(?:local-)?command-(?:name|message|args|stdout|stderr)>",
    re.DOTALL | re.IGNORECASE,
)
_EMPTY_TAG_RE = re.compile(r"<[a-zA-Z][a-zA-Z0-9\-]*\s*/?>|</[a-zA-Z][a-zA-Z0-9\-]*>")
_META_NOISE_PATTERNS = (_SYSTEM_REMINDER_RE, _LOCAL_CAVEAT_RE, _COMMAND_BLOCK_RE)


def _sanitize_long_prompt(prompt_text: str, max_chars: int = 4000) -> str:
    """剥离 system-reminder / local-command-* / command-* 等噪声块，并清理残留空标签。"""
    if not prompt_text:
        return prompt_text
    cleaned = prompt_text
    for pattern in _META_NOISE_PATTERNS:
        cleaned = pattern.sub(" ", cleaned)
    # 清掉任何残留的孤立开/闭标签（例如未配对的 <local-command-stdout> 壳）
    cleaned = _EMPTY_TAG_RE.sub(" ", cleaned)
    cleaned = re.sub(r"\n{3,}", "\n\n", cleaned)
    cleaned = re.sub(r"[ \t]{2,}", " ", cleaned).strip()
    if len(cleaned) > max_chars:
        cleaned = cleaned[-max_chars:]
    return cleaned


def _extract_responses_input(body) -> str:
    data = body.get("input", "")
    if isinstance(data, str):
        return data.strip()

    parts = []

    def add_text(value):
        if isinstance(value, str):
            value = value.strip()
            if value:
                parts.append(value)

    if isinstance(data, list):
        for item in data:
            if isinstance(item, str):
                add_text(item)
                continue
            if not isinstance(item, dict):
                continue

            content = item.get("content", "")
            if isinstance(content, str):
                add_text(content)
                continue
            if not isinstance(content, list):
                continue

            for block in content:
                if not isinstance(block, dict):
                    continue
                if block.get("type") in {"input_text", "text", "output_text"}:
                    add_text(block.get("text", ""))

    return "\n".join(parts).strip()




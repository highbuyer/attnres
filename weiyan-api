def _search_local_docs(query: str, tool_dir: str | None) -> str | None:
    """在项目 docs/ 和 README 里 grep 关键词，返回前 3 条命中摘要。"""
    if not tool_dir:
        return None
    terms = [t for t in re.findall(r"[\u4e00-\u9fff]{2,}|[A-Za-z][A-Za-z0-9_]{2,}", query) if len(t) >= 2]
    if not terms:
        return None
    try:
        result = subprocess.run(
            [
                "rg",
                "--no-heading",
                "-n",
                "--max-count", "3",
                "-i",
                "--fixed-strings",
                "--glob", "docs/**",
                "--glob", "README*",
                "--glob", "*.md",
                "-e", terms[0],
            ]
            + [arg for term in terms[1:4] for arg in ("-e", term)],
            cwd=tool_dir,
            capture_output=True,
            text=True,
            timeout=3,
        )
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return None
    lines = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    # 过滤纯命令行/代码片段/训练数据：以 `uv run`、`python `、`$`、`#`、缩进代码、JSON 开头等
    def _is_prose(line: str) -> bool:
        # rg 输出格式: path:lineno:content
        path_part, _, rest = line.partition(":")
        _, _, content = rest.partition(":")
        content = content.strip()
        if not content:
            return False
        # 直接排除训练数据文件（jsonl/json 样本）
        if path_part.endswith(".jsonl") or path_part.endswith(".json"):
            return False
        bad_prefixes = ("uv run", "python ", "python3 ", "bash ", "$ ", "# ", "```", ">>>", "import ", "from ", "{\"", "{'")
        if any(content.startswith(p) for p in bad_prefixes):
            return False
        # 含工具协议 token 或明显 JSON 片段 → 训练数据
        if "<|tool_" in content or '"messages":' in content or '"role":' in content:
            return False
        # 必须包含至少 4 个中文字符或 15 个字母字符，否则判为代码/表达式
        chinese = sum(1 for ch in content if "\u4e00" <= ch <= "\u9fff")
        if chinese < 4 and sum(1 for ch in content if ch.isalpha()) < 15:
            return False
        return True

    lines = [line for line in lines if _is_prose(line)]
    if not lines:
        return None
    return "\n".join(lines[:3])


_RESEARCH_STOPWORDS = set("的是什么吗呢何为怎么怎样如何请问给我查一下能够可以会不")
_WIKI_UA = "Mozilla/5.0 (compatible; weiyan-api/1.0; +https://zh.wikipedia.org/)"


def _candidate_titles(query: str) -> list[str]:
    """给出一组维基检索候选，按命中优先级排序。"""
    c: list[str] = []
    cleaned = "".join(ch for ch in query if ch not in _RESEARCH_STOPWORDS)
    cleaned = re.sub(r"[？?！!。.，,；;：:\s]+", " ", cleaned).strip()
    if cleaned and cleaned not in c:
        c.append(cleaned)
    # 直接抽到的词
    direct = re.findall(r"[\u4e00-\u9fff]{2,8}|[A-Za-z][A-Za-z0-9]{2,}", query)
    for m in direct:
        if m not in c:
            c.append(m)
    # 对长中文串做 n-gram 滑窗（n=4,3,2），常见复合词如"光合作用化学式" → 光合作用/化学式
    for block in re.findall(r"[\u4e00-\u9fff]{5,}", query):
        for n in (4, 3, 2):
            for i in range(len(block) - n + 1):
                gram = block[i:i + n]
                if gram in _RESEARCH_STOPWORDS or any(ch in _RESEARCH_STOPWORDS for ch in gram):
                    continue
                if gram not in c:
                    c.append(gram)
    return c


def _is_related(query: str, text: str) -> bool:
    """query 与 text 是否共享至少一个 2-gram（中文）或 3-gram（英文），用来排除过度泛化的词条。单字 query 只要 text 里出现过就算相关。"""
    if not query or not text:
        return False
    q_norm = "".join(ch for ch in query if ch not in _RESEARCH_STOPWORDS)
    q_norm = re.sub(r"[\s？?！!。.，,；;：:]+", "", q_norm)
    text_norm = re.sub(r"\s+", "", text[:500])
    if not q_norm:
        return False
    # 单字 query：只要 text 开头 100 字包含该字即算相关
    if len(q_norm) == 1:
        return q_norm in text_norm[:100]
    grams = set()
    for i in range(len(q_norm) - 1):
        grams.add(q_norm[i:i + 2])
    for g in grams:
        if g and g in text_norm:
            return True
    return False


def _extract_wiki_title(query: str) -> str:
    cands = _candidate_titles(query)
    return cands[0] if cands else query.strip()


def _wiki_lookup(query: str) -> tuple[str | None, str]:
    """查维基百科中文。返回 (摘要, 诊断原因)；找不到时摘要为 None。"""
    candidates = _candidate_titles(query)
    if not candidates:
        return None, "问题里提取不出可用的检索关键词"

    last_reason = "未知"
    for cand in candidates[:4]:  # 最多试 4 个候选
        search_url = (
            "https://zh.wikipedia.org/w/api.php?action=opensearch&limit=1&format=json&search="
            + urllib.parse.quote(cand)
        )
        try:
            req = urllib.request.Request(search_url, headers={"User-Agent": _WIKI_UA})
            with _URL_OPENER.open(req, timeout=RESEARCH_HTTP_TIMEOUT) as resp:
                data = json.loads(resp.read().decode("utf-8"))
        except urllib.error.HTTPError as exc:
            last_reason = f"检索 HTTP {exc.code}（候选「{cand}」）"
            continue
        except (urllib.error.URLError, socket.timeout, TimeoutError) as exc:
            return None, f"联网不可达 ({exc.__class__.__name__}: {exc})"
        except Exception as exc:
            last_reason = f"维基检索异常 ({exc.__class__.__name__})"
            continue
        matched_titles = data[1] if isinstance(data, list) and len(data) > 1 else []
        if not matched_titles:
            last_reason = f"候选「{cand}」未命中词条"
            continue
        real_title = matched_titles[0]
        summary_url = "https://zh.wikipedia.org/api/rest_v1/page/summary/" + urllib.parse.quote(real_title)
        try:
            req = urllib.request.Request(summary_url, headers={"User-Agent": _WIKI_UA})
            with _URL_OPENER.open(req, timeout=RESEARCH_HTTP_TIMEOUT) as resp:
                summary = json.loads(resp.read().decode("utf-8"))
        except urllib.error.HTTPError as exc:
            last_reason = f"词条页 HTTP {exc.code}（「{real_title}」）"
            continue
        except (urllib.error.URLError, socket.timeout, TimeoutError) as exc:
            return None, f"词条页请求失败 ({exc.__class__.__name__}: {exc})"
        except Exception as exc:
            last_reason = f"词条页解析失败 ({exc.__class__.__name__})"
            continue
        extract = (summary.get("extract") or "").strip()
        if not extract:
            last_reason = f"词条「{real_title}」无摘要"
            continue
        if not _is_related(query, real_title + extract):
            last_reason = f"候选「{cand}」命中「{real_title}」但内容与问题无关，已过滤"
            continue
        return f"维基百科·{real_title}：{extract}", "ok"
    return None, last_reason



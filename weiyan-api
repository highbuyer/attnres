        if not tool_dir:
            return None
        p = prompt_text.strip()
        normalized = re.sub(r"\s+", "", p).lower()

        if normalized in {
            "这个仓库做什么",
            "这个项目做什么",
            "这个仓库干什么",
            "这个项目干什么",
            "这个仓库是干嘛的",
            "这个项目是干嘛的",
            "仓库介绍",
            "项目介绍",
            "仓库用途",
            "项目用途",
        }:
            _debug("repo-shortcut", "repo shortcut hit: repo_summary")
            candidates = [

                "docs/README.md",
                "README.md",
                "docs/PROJECT_STRUCTURE.md",
                "docs/PREPARE_README.md",
                "docs/SFT_README.md",
                "docs/CONTINUE_PRETRAIN_README.md",
            ]
            snippets = []
            for rel_path in candidates:
                result = execute_tool("read_file", {"path": rel_path, "offset": 1, "limit": 24}, tool_dir)
                if result.startswith("(文件不存在") or result.startswith("(路径越界"):
                    continue
                if result.strip():
                    snippets.append((rel_path, result))
                if len(snippets) >= 2:
                    break
            if snippets:
                parts = ["我先从仓库文件里看到这些信息："]
                for rel_path, content in snippets:
                    preview = "\n".join(content.splitlines()[:5]).strip()
                    parts.append(f"- `{rel_path}`\n{preview}")
                return "\n\n".join(parts)

            return None

        if normalized in {"systemprompt在哪", "systemprompt在哪里", "提示词在哪", "提示词在哪里"}:
            _debug("repo-shortcut", "repo shortcut hit: system_prompt_location")
            result = execute_tool("search_code", {"query": "system_prompt"}, tool_dir)
            if not result or result.startswith("(未找到匹配"):
                return None
            lines = [line.strip() for line in result.splitlines() if line.strip()][:3]
            if not lines:
                return None
            locations = []
            for line in lines:
                path_part, _, remainder = line.partition(":")
                line_no, _, _ = remainder.partition(":")
                if path_part and line_no.isdigit():
                    locations.append(f"- `{path_part}:{line_no}`")
                else:
                    locations.append(f"- `{line}`")
            return "我找到的主要位置是：\n" + "\n".join(locations)

        structure_triggers = {
            "当前项目结构", "项目结构", "目录结构", "文件结构", "仓库结构",
            "项目目录", "仓库目录", "代码结构",
        }
        if normalized in structure_triggers or any(k in normalized for k in ("项目结构", "目录结构", "文件结构", "仓库结构")):
            _debug("repo-shortcut", "repo shortcut hit: project_structure")
            # 优先读 docs/PROJECT_STRUCTURE.md，没有就 ls 项目根目录
            ps = execute_tool("read_file", {"path": "docs/PROJECT_STRUCTURE.md", "offset": 1, "limit": 40}, tool_dir)
            if ps and not ps.startswith("(文件不存在") and not ps.startswith("(路径越界"):
                return "项目结构（取自 docs/PROJECT_STRUCTURE.md）：\n" + ps
            root_list = execute_tool("read_file", {"path": ".", "offset": 1, "limit": 40}, tool_dir)
            if root_list and not root_list.startswith("("):
                return f"项目根目录 `{Path(tool_dir).resolve().name}` 下主要条目：\n" + root_list
            return None

        # 文件内容直读短路：匹配到形如 FOO.md / foo.py 的引用，且问句带 "内容/有什么/看一下/读" 意图
        file_ref_match = _FILE_REF_RE.search(p)
        if file_ref_match and any(k in normalized for k in ("内容", "有什么", "看一下", "看下", "读一下", "读下", "读", "讲了什么", "写了什么")):
            rel = file_ref_match.group(1)
            _debug("repo-shortcut", f"repo shortcut hit: file_read rel={rel}")
            for try_path in (rel, f"docs/{rel}", f"src/{rel}", f"scripts/{rel}", f"tests/{rel}"):
                content = execute_tool("read_file", {"path": try_path, "offset": 1, "limit": 40}, tool_dir)
                if content and not content.startswith("(文件不存在") and not content.startswith("(路径越界"):
                    return f"`{try_path}` 前 40 行：\n" + content
            # 还是没找到：用 fd/find 按文件名全项目搜索
            try:
                located = subprocess.run(
                    ["rg", "--files", "-g", rel],
                    cwd=tool_dir,
                    capture_output=True,
                    text=True,
                    timeout=3,
                )
                hits = [line.strip() for line in located.stdout.splitlines() if line.strip()]
            except (subprocess.TimeoutExpired, FileNotFoundError):
                hits = []
            if hits:
                chosen = hits[0]
                content = execute_tool("read_file", {"path": chosen, "offset": 1, "limit": 40}, tool_dir)
                if content and not content.startswith("("):
                    extra = ""
                    if len(hits) > 1:
                        extra = f"\n\n（仓库里还有其它同名文件：{', '.join(hits[1:4])}）"
                    return f"`{chosen}` 前 40 行：\n{content}{extra}"
            return f"`{rel}` 在项目里找不到。可能是路径不对或者这个文件不在当前仓库。"

        return None

    def generate(prompt_text: str, max_tokens: int = 256, temperature: float = 0.0, req_id: str = "-") -> str:
        if max_tokens > MAX_GENERATE_TOKENS:
            _debug(req_id, f"clamp max_tokens from {max_tokens} to {MAX_GENERATE_TOKENS}")
            max_tokens = MAX_GENERATE_TOKENS

        hard_rule = apply_hard_rules(prompt_text)

        if hard_rule:
            return hard_rule
        meaningful = re.sub(r"[\s<>/\-_*#`\[\]\(\)]+", "", prompt_text)
        if len(meaningful) < 2:
            _debug(req_id, f"empty prompt short-circuit hit meaningful_len={len(meaningful)}")
            return "你好，请直接输入你的问题，例如：这个仓库做什么？"
        _greeting_norm = meaningful.lower()
        if _greeting_norm in {"你好", "您好", "hi", "hello", "hey", "在吗", "在", "嗨"}:
            _debug(req_id, f"greeting short-circuit hit norm={_greeting_norm!r}")
            return "你好！我是微研。你可以问我这个仓库的结构、代码位置，或者让我查某个函数/文件。"
        if re.search(r"今天.*?(几号|日期|星期|几月|几日)|现在.*?(几点|时间)|当前.*?(时间|日期)|what.*?(date|time).*?(today|now)", prompt_text, re.IGNORECASE):
            _debug(req_id, "datetime short-circuit hit")
            return "我是一个本地模型，没有联网也没法拿系统时钟，所以不知道当前日期和时间。你可以看看终端/任务栏上的时间。"
        if _looks_like_startup_prompt(prompt_text):
            _debug(req_id, "startup prompt short-circuit hit")
            return "已收到系统启动上下文。请直接告诉我你的具体问题，例如：这个仓库做什么？"
        tool_cap = _tool_capability_answer(prompt_text)
        if tool_cap:
            _debug(req_id, "tool capability shortcut hit")
            return tool_cap
        proj = _project_answer(prompt_text)
        if proj:
            return proj
        repo = _repo_answer(prompt_text)
        if repo:
            return repo

        # 服务端强制开启轻量采样 + top_p + no_repeat_ngram，避免贪婪解码陷入循环吸子
        effective_temperature = temperature if temperature > 0 else 0.7
        top_p = 0.9
        no_repeat_ngram = 4

        prompt_ids = [bos_id, user_id] + system_ids + tokenizer.encode(prompt_text) + [asst_id]
        x = torch.tensor([prompt_ids], dtype=torch.long, device=device)
        generated_ids = []
        last_tool_result = None
        timed_out = False
        gen_t0 = time.time()
        _debug(req_id, f"generate start prompt_len={len(prompt_text)} max_tokens={max_tokens} temp={temperature}(eff={effective_temperature}) prompt={_preview(prompt_text)!r}")


        tool_result_start_tag = "<|tool_result_start|>"

        tool_result_end_tag = "<|tool_result_end|>"

        for _round in range(4):
            round_ids = []
            round_flushed = False
            round_t0 = time.time()
            _debug(req_id, f"round={_round + 1} decode start context_tokens={x.shape[1]}")
            for step in range(max_tokens):

                if time.time() - gen_t0 >= MAX_DECODE_SECONDS:
                    timed_out = True
                    _debug(req_id, f"decode timeout after {time.time() - gen_t0:.2f}s generated={len(round_ids)} round={_round + 1}")
                    generated_ids.extend(round_ids)
                    round_flushed = True
                    break

                if step and step % HEARTBEAT_EVERY_TOKENS == 0:
                    _debug(req_id, f"round={_round + 1} heartbeat generated={step} context_tokens={x.shape[1]}")

                with torch.no_grad(), autocast_ctx:

                    logits = model(x[:, -config.sequence_len:])[:, -1, :]

                # no_repeat_ngram: 禁掉会造成 n-gram 重复的 token
                if no_repeat_ngram > 1 and len(round_ids) >= no_repeat_ngram - 1:
                    prefix = tuple(round_ids[-(no_repeat_ngram - 1):])
                    banned = []
                    for i in range(len(round_ids) - no_repeat_ngram + 1):
                        if tuple(round_ids[i:i + no_repeat_ngram - 1]) == prefix:
                            banned.append(round_ids[i + no_repeat_ngram - 1])
                    if banned:
                        logits[0, banned] = float("-inf")

                logits_scaled = logits / effective_temperature
                # top_p 核采样
                sorted_logits, sorted_idx = torch.sort(logits_scaled, descending=True, dim=-1)
                cum_probs = torch.softmax(sorted_logits, dim=-1).cumsum(dim=-1)
                mask = cum_probs > top_p
                mask[..., 0] = False  # 至少保留最高概率的 token
                sorted_logits = sorted_logits.masked_fill(mask, float("-inf"))
                filtered = torch.full_like(logits_scaled, float("-inf")).scatter_(-1, sorted_idx, sorted_logits)
                probs = torch.softmax(filtered, dim=-1)
                next_id = torch.multinomial(probs, num_samples=1)
                token_id = int(next_id.item())

                if tool_call_end_id and token_id == tool_call_end_id:
                    round_ids.append(token_id)
                    x = torch.cat([x, next_id], dim=1)
                    break
                if token_id in stop_ids:
                    break
                round_ids.append(token_id)
                x = torch.cat([x, next_id], dim=1)
            else:
                generated_ids.extend(round_ids)
                round_flushed = True
                break

            if timed_out:
                break

            decoded = tokenizer.decode(round_ids)
            _debug(req_id, f"round={_round + 1} decode done elapsed={time.time() - round_t0:.2f}s tokens={len(round_ids)} text={_preview(decoded)!r}")
            tool_parsed = None
            if round_ids and round_ids[-1] == tool_call_end_id:
                tool_parsed = parse_tool_call(decoded)
            elif TOOL_CALL_START in decoded:
                tool_parsed = parse_tool_call(decoded)

            if tool_parsed and tool_dir:
                tool_name, params = tool_parsed
                _debug(req_id, f"tool detected round={_round + 1} name={tool_name} args={_preview(params)!r}")
                tool_t0 = time.time()
                try:
                    result = execute_tool(tool_name, params, tool_dir)
                    _debug(req_id, f"tool done name={tool_name} elapsed={time.time() - tool_t0:.2f}s result={_preview(result)!r}")
                except Exception as exc:
                    result = f"[tool_error] {exc}"
                    _debug(req_id, f"tool error name={tool_name} elapsed={time.time() - tool_t0:.2f}s error={_preview(result)!r}")
                if not round_flushed:
                    generated_ids.extend(round_ids)
                    round_flushed = True
                result_text = f"{tool_result_start_tag}{result}{tool_result_end_tag}"
                result_ids = [asst_id] + enc.encode(result_text, allowed_special="all") + [asst_id]
                generated_ids.extend(result_ids)
                result_tensor = torch.tensor([result_ids], dtype=torch.long, device=device)
                x = torch.cat([x, result_tensor], dim=1)
                last_tool_result = result
                continue
            else:
                if not round_flushed:
                    generated_ids.extend(round_ids)
                    round_flushed = True
                break

        result = strip_tool_markup(tokenizer.decode(generated_ids))
        for leak in ["\nHuman:", "\nAssistant:", "Human:", "Assistant:"]:
            idx = result.find(leak)
            if idx >= 0:
                result = result[:idx].strip()
        for tag in ["<|reserved_0|>", "<|reserved_1|>", "<|reserved_2|>", "<|reserved_3|>"]:
            result = result.replace(tag, "")
        result = result.strip()
        if timed_out:
            if result:
                result = result + "\n\n[server note] Generation stopped early due to decode timeout."
            else:
                result = "[server note] Generation stopped early due to decode timeout."

        if _is_degenerate_output(result):
            _debug(req_id, f"degenerate output detected output={_preview(result)!r}")
            # 区分两种场景：输入本身是协议噪声 vs 真实问题模型答不上来
            meaningful_prompt = re.sub(r"[\s<>/\-_*#`\[\]\(\)]+", "", prompt_text)
            if len(meaningful_prompt) < 20:
                result = "这个问题我暂时答不好。你可以换个说法，或者让我查仓库里的内容（例如：某个函数在哪、README 讲了什么）。"
            else:
                result = "我收到了请求，但当前输入主要是系统启动或工具上下文，暂时没有生成有效回答。请直接输入你的问题，例如：这个仓库做什么？"

        if not result and last_tool_result:
            first_line = last_tool_result.split("\n", 1)[0].strip()
            lowered = last_tool_result.lower()
            invalid_markers = [
                "未找到匹配",
                "文件不存在",
                "工具执行错误",
                "tool_error",
                "invalid literal",
                "Traceback",
            ]
            if any(marker in last_tool_result for marker in invalid_markers) or "error" in lowered:
                result = first_line or "工具没有返回可用结果。"
            elif first_line:
                result = f"我查到了相关结果，但还没来得及整理成自然语言回答。首条结果：`{first_line}`。"

        if _is_unknown_answer(result):
            _debug(req_id, f"unknown-answer detected, entering research fallback; orig={_preview(result)!r}")
            result = _research_fallback(prompt_text, tool_dir, req_id)

        _debug(req_id, f"generate done output_len={len(result)} output={_preview(result)!r}")
        return result

    _generate_fn = generate
    _model = model


class WeiyanHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/health":
            self._json_response({"status": "ok", "model": "weiyan-400m"})
        elif self.path == "/v1/models":
            self._json_response({"data": [{"id": "weiyan-400m", "object": "model"}]})
        else:
            self._json_response({"message": "微研 API. POST /v1/chat/completions 或 /ask"})

    def do_POST(self):
        req_id = uuid.uuid4().hex[:8]
        req_t0 = time.time()
        path = urlparse(self.path).path

        try:
            length = int(self.headers.get("Content-Length", 0))
            raw_body = self.rfile.read(length) if length else b"{}"
        except (ConnectionResetError, BrokenPipeError) as exc:
            _debug(req_id, f"client disconnected while reading request path={path} error={exc}")
            return

        try:
            body = json.loads(raw_body)
        except json.JSONDecodeError as exc:
            _debug(req_id, f"bad json path={path} error={exc}")
            self._json_response({"error": {"message": "Invalid JSON body"}}, status=400)
            return

        if path == "/ask":
            prompt = body.get("prompt", "")
            prompt_text = prompt if isinstance(prompt, str) else json.dumps(prompt, ensure_ascii=False)
            max_tokens = body.get("max_tokens", 256)
            temperature = body.get("temperature", 0.0)
        elif path in ("/v1/chat/completions", "/chat/completions"):
            messages = body.get("messages", [])
            prompt = messages[-1]["content"] if messages else ""
            prompt_text = prompt if isinstance(prompt, str) else json.dumps(prompt, ensure_ascii=False)
            max_tokens = body.get("max_tokens", 256)
            temperature = body.get("temperature", 0.0)
        elif path.startswith("/v1/messages"):
            # Anthropic API 格式（Claude Code 用这个）
            messages = body.get("messages", [])
            prompt = ""
            for msg in messages:
                content = msg.get("content", "")
                if isinstance(content, list):
                    content = " ".join(b.get("text", "") for b in content if b.get("type") == "text")
                if msg.get("role") == "user":
                    prompt = content
            prompt_text = prompt if isinstance(prompt, str) else json.dumps(prompt, ensure_ascii=False)
            raw_len = len(prompt_text)
            prompt_text = _sanitize_long_prompt(prompt_text, max_chars=4000)
            if raw_len != len(prompt_text):
                _debug(req_id, f"sanitize prompt raw_len={raw_len} -> {len(prompt_text)}")
            max_tokens = body.get("max_tokens", 256)
            temperature = min(float(body.get("temperature", 0.0)), 0.2)


        elif path == "/v1/responses":
            prompt_text = _extract_responses_input(body)
            max_tokens = int(body.get("max_output_tokens") or body.get("max_tokens") or 256)
            temperature = float(body.get("temperature", 0.0))
        else:
            _debug(req_id, f"404 path={path}")
            self._json_response({"error": {"message": f"Route {path} not found"}}, status=404)
            return

        _debug(req_id, f"recv path={path} body_keys={list(body.keys())} max_tokens={max_tokens} temp={temperature} prompt={_preview(prompt_text)!r}")
        with _lock:
            answer = _generate_fn(prompt_text, max_tokens=max_tokens, temperature=temperature, req_id=req_id)
        _debug(req_id, f"request done path={path} total={time.time() - req_t0:.2f}s response_len={len(answer)}")

        if path == "/ask":
            self._json_response({"response": answer})
        elif path.startswith("/v1/messages"):
            # Anthropic 格式响应
            self._json_response({
                "id": f"msg_{uuid.uuid4().hex[:12]}",
                "type": "message",
                "role": "assistant",
                "content": [{"type": "text", "text": answer}],
                "model": "weiyan-400m",
                "stop_reason": "end_turn",
                "stop_sequence": None,
                "usage": {"input_tokens": 0, "output_tokens": 0},
            })
        elif path == "/v1/responses":
            self._json_response({
                "id": f"resp_{uuid.uuid4().hex[:12]}",
                "object": "response",
                "status": "completed",
                "model": "weiyan-400m",
                "output": [{
                    "type": "message",
                    "id": f"msg_{uuid.uuid4().hex[:12]}",
                    "role": "assistant",
                    "content": [{
                        "type": "output_text",
                        "text": answer,
                        "annotations": [],
                    }],
                }],
                "usage": {"input_tokens": 0, "output_tokens": 0, "total_tokens": 0},
            })
        else:
            self._json_response({
                "id": f"chatcmpl-{uuid.uuid4().hex[:8]}",
                "object": "chat.completion",
                "created": int(time.time()),
                "model": "weiyan-400m",
                "choices": [{
                    "index": 0,
                    "message": {"role": "assistant", "content": answer},
                    "finish_reason": "stop",
                }],
                "usage": {"prompt_tokens": 0, "completion_tokens": 0, "total_tokens": 0},
            })



    def _json_response(self, data, status=200):
        body = json.dumps(data, ensure_ascii=False).encode("utf-8")
        try:
            self.send_response(status)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        except (ConnectionResetError, BrokenPipeError):
            pass

    def log_message(self, fmt, *args):
        msg = fmt % args if args else fmt
        sys.stderr.write(f"[weiyan] {str(msg)[:80]}\n")


def main():
    parser = argparse.ArgumentParser(description="微研 API Server")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8000)
    parser.add_argument("--checkpoint", default=str(ROOT / "checkpoints" / "sft_tool_summary_v5_best.pt"))
    parser.add_argument("--tool-dir", default=str(ROOT))
    args = parser.parse_args()

    print(f"Loading model: {args.checkpoint}")
    _init_model(args.checkpoint, args.tool_dir)
    print(f"微研 API ready at http://{args.host}:{args.port}")
    print(f"  POST /v1/chat/completions  (OpenAI 兼容)")
    print(f"  POST /ask                  (简化格式)")
    print(f"  GET  /health               (健康检查)")

    server = HTTPServer((args.host, args.port), WeiyanHandler)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nShutting down.")
        server.shutdown()


if __name__ == "__main__":
    main()

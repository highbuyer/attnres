def _build_url_opener():
    """显式构造支持代理的 opener。urllib 默认也读 env，但对 HTTPS + 大写变量有时失灵，这里兜底。"""
    import os
    proxies = {}
    for scheme in ("http", "https"):
        for var in (scheme + "_proxy", (scheme + "_proxy").upper()):
            if os.environ.get(var):
                proxies[scheme] = os.environ[var]
                break
    handlers = []
    if proxies:
        handlers.append(urllib.request.ProxyHandler(proxies))
    return urllib.request.build_opener(*handlers)


_URL_OPENER = _build_url_opener()


def _research_fallback(prompt_text: str, tool_dir: str | None, req_id: str) -> str:
    """模型拒答时：（项目类问题）本机 docs → 维基百科 → 诚实说明原因。通用知识问题跳过本机 docs。"""
    project_scoped = bool(_PROJECT_SCOPE_KEYWORDS.search(prompt_text))
    local_reason = "通用问题，跳过本机 docs"
    if project_scoped:
        local = _search_local_docs(prompt_text, tool_dir)
        if local:
            _debug(req_id, f"research fallback hit local {len(local)} chars")
            return "模型没直接掌握，但在项目文档里找到相关条目：\n" + local
        local_reason = "本机文档未命中"
    wiki, reason = _wiki_lookup(prompt_text)
    if wiki:
        _debug(req_id, f"research fallback hit wiki len={len(wiki)}")
        return "模型没直接掌握，以下摘自维基百科（请自行验证）：\n" + wiki
    _debug(req_id, f"research fallback gave up local={local_reason} wiki={reason}")
    return (
        "我对这个问题没有把握。尝试过的查证：\n"
        f"- 本机项目文档：{local_reason}\n"
        f"- 维基百科中文：{reason}\n"
        "如果能提供更精确的关键词或上下文，我可以再试一次。"
    )


